#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define CHARYBDIS_MINIMUM_DEFAULT_DPI 400
#define CHARYBDIS_DEFAULT_DPI_CONFIG_STEP 200

&mmv { time-to-max-speed-ms = <200>; };

&lt { tapping-term-ms = <150>; };

/ {
    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 1>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 2>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp ESC         &kp N1  &kp N2  &kp N3     &kp N4          &kp N5          &kp N6                       &kp N7     &kp N8     &kp N9   &kp N0            &kp MINUS
&kp GRAVE       &kp Q   &kp W   &kp E      &kp R           &kp T           &kp Y                        &kp U      &kp I      &kp O    &kp P             &kp SEMICOLON
&kp LEFT_SHIFT  &kp A   &kp S   &kp D      &kp F           &kp G           &kp H                        &kp J      &kp K      &kp L    &kp SLASH         &kp SQT
&kp LCTRL       &kp Z   &kp X   &kp C      &kp V           &kp B           &kp N                        &kp M      &kp COMMA  &kp DOT  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
                                &lt 2 TAB  &lt 1 SPACE     &lt 3 DELETE    &lt 1 BACKSPACE              &kp ENTER
                                           &lt 4 LEFT_GUI  &kp LEFT_ALT    &mt LEFT_ALT LA(LEFT_SHIFT)
            >;
        };

        F_layers {
            bindings = <
&kp F1          &kp F2  &kp F3          &kp F4                   &kp F5           &kp F6           &kp F7     &kp F8     &kp F9     &kp F10    &kp F11  &kp F12
&none           &none   &none           &none                    &none            &kp BACKSLASH    &kp EQUAL  &none      &none      &none      &none    &bt BT_NXT
&kp LEFT_SHIFT  &none   &none           &kp UP_ARROW             &none            &trans           &none      &mkp LCLK  &mkp RCLK  &mkp MCLK  &none    &bt BT_PRV
&kp LCTRL       &none   &kp LEFT_ARROW  &kp DOWN_ARROW           &kp RIGHT_ARROW  &kp F5           &none      &none      &trans     &trans     &none    &bt BT_CLR
                                        &kp LANG_ZENKAKUHANKAKU  &trans           &kp GRAVE        &none      &none
                                                                 &trans           &trans           &trans
            >;
        };

        NUM_Layers {
            bindings = <
&trans  &none      &none   &none   &none   &none         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp MINUS  &kp N7  &kp N8  &kp N9  &kp COLON     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp N0     &kp N4  &kp N5  &kp N6  &kp SLASH     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &kp N1  &kp N2  &kp N3  &kp PERIOD    &none   &trans  &trans  &trans  &trans  &trans
                           &trans  &trans  &trans        &trans  &trans
                                   &trans  &trans        &trans
            >;
        };

        scroll-layers {
            bindings = <
&trans  &trans     &trans          &trans          &trans           &trans    &trans         &trans     &trans     &trans     &trans     &kp F12
&trans  &kp LC(Q)  &kp LC(W)       &none           &none            &none     &kp LC(A)      &kp LC(C)  &kp LC(X)  &kp LC(V)  &kp LC(Z)  &trans
&trans  &none      &none           &kp UP_ARROW    &none            &none     &trans         &mkp LCLK  &mkp RCLK  &mkp MCLK  &trans     &trans
&trans  &none      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none     &kp LC(LS(N))  &trans     &trans     &trans     &trans     &kp LC(LS(S))
                                   &trans          &trans           &trans    &trans         &trans
                                                   &trans           &trans    &trans
            >;
        };

        snipe-layers {
            bindings = <
&trans        &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans     &trans     &trans  &trans
&bt BT_SEL 0  &trans  &trans  &trans  &trans  &trans    &trans     &none      &none      &none      &trans  &bt BT_NXT
&bt BT_SEL 1  &trans  &trans  &trans  &trans  &trans    &none      &mkp LCLK  &mkp RCLK  &mkp MCLK  &trans  &bt BT_PRV
&bt BT_SEL 2  &trans  &trans  &trans  &trans  &trans    &trans     &none      &none      &none      &trans  &bt BT_CLR
                              &trans  &trans  &trans    &mkp LCLK  &mkp RCLK
                                      &trans  &trans    &trans
            >;
        };
    };
};
